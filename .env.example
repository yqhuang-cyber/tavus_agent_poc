# Native web POC defaults to offline, with real Pi execution and a synthetic model.
# Set both modes to live to use Tavus and the independently configured Pi planner.
PORT=8787
HOST=127.0.0.1
OPERATOR_TOKEN=replace-with-at-least-32-random-characters
MODEL_MODE=fixture
TAVUS_MODE=offline
RESOURCE_LEDGER=.runtime/resources.json
# Pi planning model only; Tavus-hosted tavus-gemma-4 generates live spoken replies.
PI_MODEL_ID=
PI_MODEL_BASE_URL=
PI_MODEL_API_KEY=
TAVUS_API_KEY=
TAVUS_FACE_ID=
# Optional: leave empty to use the Face default Voice.
TAVUS_VOICE_ID=
GATEWAY_PUBLIC_URL=
