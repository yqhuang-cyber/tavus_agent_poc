# M0 defaults to offline: real Pi execution with a deterministic synthetic model.
PORT=8787
HOST=127.0.0.1
OPERATOR_TOKEN=replace-with-at-least-32-random-characters
MODEL_MODE=fixture
TAVUS_MODE=offline
RESOURCE_LEDGER=.runtime/resources.json
# These live settings belong to the retained custom-LLM probe, not the native pipeline.
# Pi needs its own callable model; Tavus-hosted tavus-gemma-4 is not its endpoint.
PI_MODEL_ID=
PI_MODEL_BASE_URL=
PI_MODEL_API_KEY=
TAVUS_API_KEY=
TAVUS_FACE_ID=
TAVUS_VOICE_ID=
GATEWAY_PUBLIC_URL=
